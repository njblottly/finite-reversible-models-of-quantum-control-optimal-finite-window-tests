 RowBox[{"Get", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<verify.wl\>\""}],
     "}"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.003000565484602*^9, 
  4.003000566573794*^9}},ExpressionUUID->"8e54e60d-be68-4651-a344-\
16e4371ebd94"],

Cell["\<\
In addition to Mathematica validation, a recorded independent result us \
Mathics3 10.0.1 passed 260 exact checks. The optimal radius was \
0.25076868003434436295. See ../data/wolfram_checks.txt for the complete \
actual execution record. \
\>", "Text",
 CellChangeTimes->{{4.003000579122285*^9, 
