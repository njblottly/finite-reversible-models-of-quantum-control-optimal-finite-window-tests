Cell[CellGroupData[{
Cell["Finite reversible control : exact certificates", "Title",
 CellChangeTimes->{{4.0030004516443853`*^9, 4.003000451645679*^9}, 
   4.003000491482463*^9},ExpressionUUID->"9ae29035-cf6c-47b1-ae92-\
05dd38ee2b24"],

Cell["\<\
Each pair {a, b} denotes a + b Sqrt[2] . The verification source checks the \
45 - variable optimal certificate exactly. Evaluate the following cell in \
Mathematica to record a native run .
\
\>", "Text",
 CellChangeTimes->{{4.0030004981857157`*^9, 4.0030005223590927`*^9}, {
  4.0030005570295563`*^9, 
  4.003000561985558*^9}},ExpressionUUID->"9568cb6e-1ee4-4ce8-bb51-\
a1266c224ce8"],

